{
  "classifier": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "risk",
      "predicted_class",
      "severity",
      "effect_summary",
      "evidence_spans",
      "missing_context",
      "review_required",
      "reason_codes",
      "policy_refs",
      "risk_identifiable"
    ],
    "properties": {
      "risk": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^CAT-[0-9]+\\.[0-9]+$"
      },
      "predicted_class": {
        "enum": [
          "allow",
          "ask",
          "deny",
          null
        ]
      },
      "severity": {
        "enum": [
          "low",
          "medium",
          "high",
          "critical",
          null
        ]
      },
      "effect_summary": {
        "type": "string",
        "minLength": 1
      },
      "evidence_spans": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "missing_context": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "review_required": {
        "type": "boolean"
      },
      "reason_codes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "policy_refs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "risk_identifiable": {
        "type": "boolean"
      }
    }
  },
  "semantic": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "actions",
      "missing_context"
    ],
    "properties": {
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "evidence",
            "conditional",
            "wrapper"
          ],
          "properties": {
            "effect": {
              "type": "string"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "conditional": {
              "type": "boolean"
            },
            "wrapper": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "missing_context": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "critic": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "verdict",
      "reason",
      "policy_refs",
      "evidence_spans"
    ],
    "properties": {
      "verdict": {
        "enum": [
          "agree",
          "disagree",
          "insufficient_evidence"
        ]
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "policy_refs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "evidence_spans": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
