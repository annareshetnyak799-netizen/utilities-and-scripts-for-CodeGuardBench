{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risk",
    "predicted_class",
    "severity",
    "effect_summary",
    "evidence_spans",
    "missing_context",
    "review_required",
    "reason_codes",
    "policy_refs"
  ],
  "properties": {
    "risk": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CAT-[0-9]+\\.[0-9]+$"
    },
    "predicted_class": {
      "enum": [
        "allow",
        "ask",
        "deny",
        null
      ]
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        null
      ]
    },
    "effect_summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_required": {
      "type": "boolean"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
